# Pane build profile — all cloud/hosted flags hard-off.
# Loaded by `build:agent:pane` / `build:server:pane`.
# Do NOT set any of these to true — the pane build must be free of
# Pane-server surfaces. See lib/constants/product-features.ts.
PANE_BUILD=true
VITE_HOSTED_INFERENCE=false
VITE_CLOUD_SYNC=false
VITE_KLAVIS_INTEGRATIONS=false
VITE_REMOTE_HERMES=false
VITE_CREDITS_BILLING=false
